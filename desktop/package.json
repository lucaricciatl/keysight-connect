{
  "name": "keysight-connect",
  "productName": "Keysight Connect",
  "version": "0.1.0",
  "description": "Desktop app for Keysight B2901B source/measure units",
  "author": "Luca Ricci",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "KEYSIGHT_DEV=1 electron .",
    "build:web": "npm --prefix ../web run build",
    "build:backend": "node scripts/build-backend.mjs",
    "dist": "node scripts/build-app.mjs",
    "release": "node scripts/release.mjs",
    "icon": "python3 scripts/make-icon.py",
    "probe": "node --experimental-websocket scripts/probe.js"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.lucaricci.keysightconnect",
    "productName": "Keysight Connect",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "backend",
        "filter": [
          "smu_core.py",
          "README.md",
          "server/*.py",
          "web/dist/**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "backend-dist/keysight-backend",
        "to": "backend/keysight-backend",
        "filter": ["**/*"]
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [{ "target": "dmg", "arch": ["arm64"] }]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} portable.${ext}"
    }
  }
}
